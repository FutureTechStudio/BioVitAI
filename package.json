{
  "name": "biovitai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared/*",
    "apps/mobile"
  ],
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "setup:local": "node tools/setup-local.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "npm run build && node --env-file=.env.local tools/migrate-db.mjs",
    "db:native:stop": "node tools/stop-native-postgres.mjs",
    "jobs:once": "npm run build && node --env-file=.env.local tools/run-local-jobs.mjs",
    "dev:api": "npm run build && node --env-file=.env.local dist/apps/api/src/main.js",
    "dev:local": "npm run build && node --env-file=.env.local tools/dev-local.mjs",
    "test:db": "npm run build && node --test tests/integration/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:web && npm run typecheck:mobile",
    "typecheck:mobile": "npm exec --workspace apps/mobile -- tsc --noEmit",
    "setup:reports": "node tools/setup-report-tools.mjs",
    "setup:android": "node tools/setup-android.mjs",
    "setup:backup": "node tools/setup-postgres-client.mjs",
    "build:android": "node tools/build-android.mjs",
    "dev:mobile": "node --dns-result-order=ipv4first node_modules/expo/bin/cli start apps/mobile --localhost",
    "reports:worker": "node --env-file=.env.local tools/run-report-worker.mjs",
    "pilot:backup": "node --env-file=.env.local tools/pilot-backup.mjs",
    "pilot:ops": "node --env-file=.env.local tools/pilot-ops.mjs",
    "lint": "eslint . && node tools/check-boundaries.mjs && node tools/check-p0-gate.mjs",
    "gate:p0": "node tools/check-p0-gate.mjs --require-open",
    "gate:p0:full": "node tools/check-p0-gate.mjs --full-review --require-open",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "dev:web": "next dev apps/web --webpack --hostname 127.0.0.1 --port 3000",
    "build:web": "next build apps/web --webpack",
    "start:web": "next start apps/web --hostname 127.0.0.1 --port 3000",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "test:web": "playwright test",
    "test:web:isolated": "npm run build && node tools/run-web-tests.mjs",
    "test:web:community-off": "npm run build && node tools/run-web-tests.mjs --community-off"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.12",
    "@tesseract.js-data/eng": "1.0.0",
    "better-auth": "1.7.12",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
